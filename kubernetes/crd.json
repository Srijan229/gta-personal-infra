{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": { "name": "applicationscalingpolicies.portfolio.gta.dev" },
  "spec": {
    "group": "portfolio.gta.dev",
    "scope": "Namespaced",
    "names": {
      "plural": "applicationscalingpolicies",
      "singular": "applicationscalingpolicy",
      "kind": "ApplicationScalingPolicy",
      "shortNames": ["asp"]
    },
    "versions": [
      {
        "name": "v1alpha1",
        "served": true,
        "storage": true,
        "subresources": { "status": {} },
        "additionalPrinterColumns": [
          {
            "name": "State",
            "type": "string",
            "jsonPath": ".status.windowState"
          },
          {
            "name": "Minimum",
            "type": "integer",
            "jsonPath": ".status.minReplicas"
          },
          {
            "name": "Ready",
            "type": "string",
            "jsonPath": ".status.conditions[0].status"
          }
        ],
        "schema": {
          "openAPIV3Schema": {
            "type": "object",
            "properties": {
              "spec": {
                "type": "object",
                "required": [
                  "idleReplicas",
                  "openReplicas",
                  "maxReplicas",
                  "prewarmSeconds",
                  "cooldownSeconds"
                ],
                "x-kubernetes-validations": [
                  {
                    "rule": "self.openReplicas >= self.idleReplicas",
                    "message": "openReplicas must be at least idleReplicas"
                  },
                  {
                    "rule": "self.maxReplicas >= self.openReplicas",
                    "message": "maxReplicas must be at least openReplicas"
                  }
                ],
                "properties": {
                  "idleReplicas": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "openReplicas": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "maxReplicas": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "prewarmSeconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600
                  },
                  "cooldownSeconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600
                  },
                  "opensAt": { "type": "string", "format": "date-time" }
                }
              },
              "status": {
                "type": "object",
                "x-kubernetes-preserve-unknown-fields": true
              }
            }
          }
        }
      }
    ]
  }
}
